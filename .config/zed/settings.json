// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },
  "diff_view_style": "split",
  "unnecessary_code_fade": 0.5,
  "ui_font_weight": 500.0,
  "relative_line_numbers": "enabled",
  "which_key": {
    "enabled": true,
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "right",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "redact_private_values": false,
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "edit_predictions": {
    "provider": "zed",
    "open_ai_compatible_api": {
      "api_url": "https://api.minimax.io/v1",
      "model": "MiniMax-M2.7",
      "max_output_tokens": 64,
    },
  },
  "language_models": {
    "openai_compatible": {
      "MiniMax": {
        "api_url": "https://api.minimax.io/v1",
        "available_models": [
          {
            "name": "MiniMax-M3",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false
            }
          }
        ]
      }
    },
    "opencode": {
      "show_zen_models": false,
    },
  },
  "agent_buffer_font_size": 17.0,
  "agent_ui_font_size": 20.0,
  "buffer_line_height": "standard",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_weight": 100.0,
  "load_direnv": "shell_hook",
  "agent": {
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "MiniMax",
      "model": "MiniMax-M3",
      "enable_thinking": false,
    },
    "dock": "left",
    "flexible": false,
    "single_file_review": true,
  },
  "ui_font_size": 20.0,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Mirage",
    "dark": "Ayu Mirage",
  },
  "vim_mode": true,
  "helix_mode": true,
  "vim": {
    // "default_mode": "normal",
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "always",
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "OpenCode": {
      "favorite_config_option_values": {
        "model": ["minimax-coding-plan/MiniMax-M2.7", "opencode-go/glm-5.1"],
      },
      "favorite_models": [
        "minimax-coding-plan/MiniMax-M2.7",
        "opencode-go/glm-5",
      ],
      "default_mode": "plan",
      "default_model": "minimax-coding-plan/MiniMax-M2.7",
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
    },
  },
  "languages": {
    "JSON": {
      "language_servers": ["json-language-server", "!*"],
    },
  },
}
